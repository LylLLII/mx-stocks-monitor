# WorkBuddy 内部目录（含项目记忆，不入库）
.workbuddy/

# Python
__pycache__/
*.pyc
.venv/

# 临时筛选输出（脚本运行时产生，无需版本控制）
mx_stocks_screener/_*/
mx_stocks_screener/_tmp/
mx_stocks_screener/mx_stocks_screener_*.csv
mx_stocks_screener/mx_stocks_screener_*_description.txt
auth_qr.png
*auth_qr.png
monitor.log

# 仅保留观察池（跨机同步的核心数据）
!mx_stocks_screener/观察池_累计.csv

# 敏感凭据防御（防止 token/密钥误入库）
.env
*.env
!*.env.example

# 【硬性规则】本地私有文件，严禁入库（任何 git add 方式均被忽略，含 git add -A）。
# 观察池_操作.html 含个人交易策略操作清单，只允许存在本地。
